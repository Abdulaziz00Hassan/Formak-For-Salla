# ════════════════════════════════════════════════════════════════════════
# Formak — قالب متغيرات البيئة
# ════════════════════════════════════════════════════════════════════════
# ⚠️ هذا القالب يوثّق كل الـ16 متغير يتعامل معها الكود فعلاً.
#    المتغيرات الـ5 الناقصة من الإصدار السابق (CRON_SECRET،
#    WHATSAPP_APP_SECRET، WHATSAPP_WEBHOOK_VERIFY_TOKEN،
#    WHATSAPP_DESIGNER_NOTIFICATION_TEMPLATE، WHATSAPP_TEMPLATE_LANGUAGE)
#    أُضيفت بعد ربط الـwebhook الواتساب + Cron في Handoff-4.
#    متغيّر إضافي (SALLA_CALLBACK_URL) كان مُستخدَماً بالكود بدون توثيق.
#
# ⚠️ طريقة الاستخدام:
#    1) انسخ هذا الملف إلى .env.local (لا تُسجَّل .env.local بالـGit)
#    2) استبدل كل قيمة "your_..."_here بالقيمة الحقيقية
#    3) المتغيرات المعلَّمة بـ **سري** يجب ألّا تُرفع لـGitHub أبداً
#
# المرجع: Formak-Ai-Context-v3.md + Formak-Handoff-4.md (القسم 2 — env vars الفعلية)
# ════════════════════════════════════════════════════════════════════════

# ─── Salla Integration (OAuth + Webhook) ───────────────────────────────
# Salla Partners → تطبيقك → App Credentials
SALLA_CLIENT_ID=your_client_id_here
SALLA_CLIENT_SECRET=your_client_secret_here              # **سري**
# Salla Partners → إعدادات الـWebhook → Signing Secret
SALLA_WEBHOOK_SECRET=your_webhook_secret_here            # **سري**
# عنوان الـcallback لـOAuth (Custom Mode) — يجب أن يكون HTTPS ومطابقًا حرفيًا
# لما سُجّل في بوابة الشركاء (حتى / زائدة تكسره)
SALLA_CALLBACK_URL=https://your-app.vercel.app/api/auth/callback

# ─── Supabase (Auth + Database) ──────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here   # **سري**

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────
# Meta Business Manager → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token          # **سري**
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# ─── WhatsApp Template (اسم + لغة معتمدة فعليًا) ──────────────────────
# ⚠️ الاسم الفعلي الحرفي للقالب المعتمد من Meta — لا تغيّره بعد الاعتماد
WHATSAPP_DESIGNER_NOTIFICATION_TEMPLATE=order_for_designer
# ⚠️ اللغة التي اعتُمد بها القالب فعليًا — ليست ar الافتراضية (مُكتشف Handoff-4 #24)
WHATSAPP_TEMPLATE_LANGUAGE=ar_AE

# ─── WhatsApp Webhook (استقبال حالات التسليم) ─────────────────────────
# Meta App → Webhooks → Signing Secret (نفس secret الـApp)
WHATSAPP_APP_SECRET=your_whatsapp_app_secret              # **سري**
# نص عشوائي تُعرّفه عند إعداد الـwebhook في Meta للتحقق (handshake)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token

# ─── Vercel Cron (تجديد access_token) ────────────────────────────────
# ⚠️ خَلِق هذا المتغير يدويًا في Vercel dashboard كأي متغير بيئة عادي.
#    Vercel لا يُولّد CRON_SECRET تلقائيًا (تصحيح Handoff-4 #26).
#    يفضل: `openssl rand -hex 32` لتوليد قيمة قوية 64-حرف.
CRON_SECRET=your_cron_secret_here                          # **سري**

# ─── NextAuth (اختياري — احتياطي لتوسعة مستقبلية) ─────────────────────
NEXTAUTH_SECRET=your_nextauth_secret_here                 # **سري**
NEXTAUTH_URL=http://localhost:3000
